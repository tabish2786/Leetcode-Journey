class Solution(object):
    def getRow(self, rowIndex):
        """
        :type rowIndex: int
        :rtype: List[int]
        """
        if not rowIndex:
            return[1]
        res = [1]
        for i in range(1, rowIndex+1):
            row = [1]
            for j in range(1, i):
                row.append(res[j-1] + res[j])
            row.append(1)
            res = row
        return res