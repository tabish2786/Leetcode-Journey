class Solution(object):
    def isValid(self, s):
        """
        :type s: str
        :rtype: bool
        """
        stack = []
        pairs = {')':'(', ']':'[', '}':'{'}

        for c in s:
            if c in pairs and (not stack or stack.pop() != pairs[c]):
                return False
            if c not in pairs:
                stack.append(c)

        return not stack