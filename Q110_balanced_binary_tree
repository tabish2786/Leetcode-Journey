# Definition for a binary tree node.
# class TreeNode(object):
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
class Solution(object):
    def isBalanced(self, root):
        """
        :type root: Optional[TreeNode]
        :rtype: bool
        """
        def f(node):
            if not node:
                return 0
            l = f(node.left)
            r = f(node.right)
            if l == -1 or r == -1 or abs(l-r)>1:
                return -1
            return 1 + max(l, r)
        return f(root) != -1