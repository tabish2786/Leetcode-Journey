class Solution(object):
    def plusOne(self, digits):
        """
        :type digits: List[int]
        :rtype: List[int]
        """
        num = 0
        
        for d in digits:
            num = num * 10 + d
        
        num += 1
        result = []
        s = str(num)
        for x in s:
            result.append(int(x))
        return result